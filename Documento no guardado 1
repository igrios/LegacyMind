{
  "sourceCode": "CREATE OR REPLACE PACKAGE PKG_CONFIGURACION AS c_umbral_notificacion CONSTANT NUMBER := 500; c_tasa_mora_diaria CONSTANT NUMBER := 0.05; END PKG_CONFIGURACION; / CREATE OR REPLACE VIEW V_ESTADO_CRITICO AS SELECT c.cliente_id, c.nombre, ct.saldo_total, c.estado FROM CLIENTES c JOIN CUENTAS ct ON c.cliente_id = ct.cliente_id WHERE c.estado = 'JUDICIAL' OR ct.saldo_total > 10000; /"
}



{
  "sourceCode": "CREATE OR REPLACE PACKAGE PKG_COBRANZAS AS PROCEDURE SP_EVALUAR_RIESGO(p_cliente_id NUMBER); FUNCTION FN_CALCULAR_DEUDA(p_cliente_id NUMBER) RETURN NUMBER; END PKG_COBRANZAS; / CREATE OR REPLACE PACKAGE BODY PKG_COBRANZAS AS PROCEDURE SP_EVALUAR_RIESGO(p_cliente_id NUMBER) IS v_deuda NUMBER; BEGIN v_deuda := FN_CALCULAR_DEUDA(p_cliente_id); IF v_deuda > PKG_CONFIGURACION.c_umbral_notificacion THEN UPDATE CLIENTES SET estado = 'MOROSO' WHERE cliente_id = p_cliente_id; PKG_AUDITORIA.SP_REGISTRAR_EVENTO('Riesgo detectado para cliente: ' || p_cliente_id); END IF; END SP_EVALUAR_RIESGO; FUNCTION FN_CALCULAR_DEUDA(p_cliente_id NUMBER) RETURN NUMBER IS v_total NUMBER; BEGIN SELECT SUM(monto) INTO v_total FROM DEUDAS WHERE cliente_id = p_cliente_id; RETURN NVL(v_total, 0); END FN_CALCULAR_DEUDA; END PKG_COBRANZAS; /"
}


{
  "sourceCode": "CREATE OR REPLACE PROCEDURE SP_MONITOR_SISTEMA IS BEGIN FOR r IN (SELECT * FROM V_ESTADO_CRITICO) LOOP IF r.saldo_total > PKG_CONFIGURACION.c_umbral_notificacion THEN PKG_NOTIFICACIONES.SP_ENVIAR_EMAIL(r.cliente_id, 'ALERTA_CRITICA'); PKG_AUDITORIA.SP_REGISTRAR_EVENTO('Notificación enviada a: ' || r.nombre); END IF; END LOOP; END SP_MONITOR_SISTEMA; /"
}
